{
  "$schema": "https://schema.railpack.com",
  "packages": {
    "haxe": "4.3.7"
  },
  "buildAptPackages": ["neko"],
  "deploy": {
    "variables": {
      "HAXELIB_PATH": "/app/.haxelib",
      "HAXE_STD_PATH": "/root/.local/share/mise/installs/haxe/4.3.7/std"
    }
  },
  "steps": {
    "build": {
      "commands": [
        "mkdir -p /app/.haxelib",
        "mkdir -p /root",
        "printf /app/.haxelib > /root/.haxelib",
        "haxelib install --always /app/resources/hx/install.hxml",
        "openssl genrsa -out /app/storage/app/private/privkey.pem",
        "openssl rsa -in /app/storage/app/private/privkey.pem -pubout -out /app/storage/app/private/pubkey.pem",
        "..."
      ]
    }
  }
}
